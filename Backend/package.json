{
  "name": "civicconnect-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "lint": "eslint .",
    "migrate": "node src/db/migrate.js",
    "seed": "node -e \"import('./src/db/seed.js').then(async ({seed}) => { await seed(); process.exit(0); })\"",
    "reset": "node src/db/reset.js",
    "db:check": "node src/db/check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "zod": "^4.1.11",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "eslint": "^9.37.0"
  }
}
